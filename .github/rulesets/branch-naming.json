{
  "name": "Branch naming",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "main or a recognized prefix with a lowercase description",
        "negate": false,
        "operator": "regex",
        "pattern": "^(main|gh-pages|(feat|fix|docs|chore|research|refactor|test|ci|hotfix|release)/[a-z0-9][a-z0-9._-]*|dependabot/[A-Za-z0-9._/-]+)$"
      }
    }
  ]
}
